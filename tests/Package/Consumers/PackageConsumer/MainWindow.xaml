<Window x:Class="PackageConsumer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Package consumer" Width="800" Height="600">
    <ui:NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsSettingsVisible="True" IsBackButtonVisible="Collapsed">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Home" IsSelected="True" />
        </ui:NavigationView.MenuItems>
        <StackPanel Margin="24">
            <ui:InfoBar x:Name="Info" Title="InfoBar" Message="Hello from the package." IsOpen="True" IsClosable="True" />
            <ui:NumberBox x:Name="Number" Header="NumberBox" Value="42" SpinButtonPlacementMode="Inline" />
            <Button Content="Accent button" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ui:NavigationView>
</Window>
