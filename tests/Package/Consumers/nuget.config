<?xml version="1.0" encoding="utf-8"?>
<!--
    iNKORE.UI.WPF.Modern comes only from the folder in INKORE_PACKAGE_FEED, which Test-Consumers.ps1 points at the
    package under test; everything else comes from nuget.org. Packages are cached in packages/ next to this file,
    away from the machine-wide cache.
-->
<configuration>
    <config>
        <add key="globalPackagesFolder" value="packages" />
    </config>
    <packageSources>
        <clear />
        <add key="package-under-test" value="%INKORE_PACKAGE_FEED%" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <fallbackPackageFolders>
        <clear />
    </fallbackPackageFolders>
    <packageSourceMapping>
        <packageSource key="package-under-test">
            <package pattern="iNKORE.UI.WPF.Modern" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
